<Window x:Class="WorkTime.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime"
        Width="460"
        Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI">

    <Border Background="#F8F7F4"
            BorderBrush="#E2DDD4"
            BorderThickness="1"
            CornerRadius="18"
            Padding="28">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="5"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="WORKTIME"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#C58A22"
/>

                <TextBlock x:Name="ProjectNameText"
                           Margin="0,6,0,0"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0D1B36"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Message -->
            <Grid Grid.Row="1"
                  Margin="0,20,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="44"
                        Height="44"
                        VerticalAlignment="Top"
                        Background="#FFF1C9"
                        CornerRadius="22">

                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#9A6510"/>

                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="MessageText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#0D1B36"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="DetailsText"
                               Margin="0,7,0,0"
                               FontSize="14"
                               Foreground="#78859D"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

            <!-- OK -->
            <Button Grid.Row="2"
                    Width="110"
                    Height="42"
                    HorizontalAlignment="Right"
                    Content="OK"
                    Click="Ok_Click"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#C58A22"
                    BorderThickness="0">

                <Button.Template>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>

    </Border>

</Window>
