<Window x:Class="WorkTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime"
        Width="760"
        Height="720"
        MinWidth="700"
        MinHeight="650"
        Background="#F8F7F4"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- =========================================================
             COLORS
             ========================================================= -->

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0D1B36"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#78859D"/>

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#C58A22"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2DDD4"/>


        <!-- =========================================================
             PROJECT COMBOBOX ITEM
             ========================================================= -->

        <Style x:Key="ProjectComboBoxItem"
               TargetType="ComboBoxItem">

            <Setter Property="Padding"
                    Value="14,11"/>

            <Setter Property="Margin"
                    Value="5,3"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#FFF4DF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F3D79E"/>

                                <Setter Property="Foreground"
                                        Value="#744600"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             PROJECT COMBOBOX
             ========================================================= -->

        <Style x:Key="ProjectComboBox"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ProjectComboBoxItem}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="ClosedBorder"
                                                Background="White"
                                                BorderBrush="#DDD7CC"
                                                BorderThickness="1"
                                                CornerRadius="14">

                                            <Grid Margin="17,0,14,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="30"
                                                        Height="30"
                                                        Background="#FFF2D8"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">

                                                    <TextBlock Text="▣"
                                                               Foreground="#B97805"
                                                               FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedItem.Name,
                                                               RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#0D1B36"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="⌄"
                                                           Foreground="#B97805"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="ClosedBorder"
                                                        Property="BorderBrush"
                                                        Value="#D2A34F"/>

                                                <Setter TargetName="ClosedBorder"
                                                        Property="Background"
                                                        Value="#FFFCF7"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Margin="0,7,0,0"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        Background="White"
                                        BorderBrush="#E2D8C8"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="5">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="4"
                                                          Opacity="0.18"/>

                                    </Border.Effect>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             ADD PROJECT BUTTON
             ========================================================= -->

        <Style x:Key="AddProjectButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="58"/>

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDD7CC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#B97805"/>

            <Setter Property="FontSize"
                    Value="30"/>

            <Setter Property="FontWeight"
                    Value="Light"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFF4DF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D2A34F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F3D79E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             TIMER ACTION BUTTON BASE
             ========================================================= -->

        <Style x:Key="TimerButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="76"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F7F7F7"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#E2E2E2"/>

                                <Setter Property="Foreground"
                                        Value="#A4ACB8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="StartButton"
               TargetType="Button"
               BasedOn="{StaticResource TimerButton}">

            <Setter Property="Background"
                    Value="#F5F7F9"/>

            <Setter Property="BorderBrush"
                    Value="#DFE3E8"/>

            <Setter Property="Foreground"
                    Value="#65758A"/>

        </Style>


        <Style x:Key="PauseButton"
               TargetType="Button"
               BasedOn="{StaticResource TimerButton}">

            <Setter Property="Background"
                    Value="#FFF5E5"/>

            <Setter Property="BorderBrush"
                    Value="#F0D39B"/>

            <Setter Property="Foreground"
                    Value="#A86B08"/>

        </Style>


        <Style x:Key="ResumeButton"
               TargetType="Button"
               BasedOn="{StaticResource TimerButton}">

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="BorderBrush"
                    Value="#D7E5F8"/>

            <Setter Property="Foreground"
                    Value="#286CC0"/>

        </Style>


        <Style x:Key="FinishButton"
               TargetType="Button"
               BasedOn="{StaticResource TimerButton}">

            <Setter Property="Background"
                    Value="#FFF0F0"/>

            <Setter Property="BorderBrush"
                    Value="#F2CACA"/>

            <Setter Property="Foreground"
                    Value="#C52020"/>

        </Style>


        <!-- =========================================================
             HISTORY BUTTON
             ========================================================= -->

        <Style x:Key="HistoryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="84"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E1DDD5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="HistoryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="HistoryBorder"
                                        Property="Background"
                                        Value="#FFFCF7"/>

                                <Setter TargetName="HistoryBorder"
                                        Property="BorderBrush"
                                        Value="#D8B46D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="HistoryBorder"
                                        Property="Background"
                                        Value="#FFF4DF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         PAGE
         ============================================================= -->

    <Grid Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#FFF0D7"
                    CornerRadius="17">

                <TextBlock Text="◷"
                           Foreground="#B97805"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="WorkTime"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Учёт рабочего времени"
                           FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0"/>

            </StackPanel>

        </Grid>


        <!-- =========================================================
             PROJECT
             ========================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,22">

            <TextBlock Text="Проект"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="2,0,0,8"/>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Style="{StaticResource ProjectComboBox}"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          DisplayMemberPath="Name"
                          SelectionChanged="Project_SelectionChanged"/>

                <Button Grid.Column="1"
                        Content="+"
                        ToolTip="Добавить проект"
                        Style="{StaticResource AddProjectButton}"
                        Margin="12,0,0,0"
                        Click="NewProject_Click"/>

                <Button Grid.Column="1"
                        Content="⚙"
                        ToolTip="Настройки проекта"
                        Style="{StaticResource AddProjectButton}"
                        FontSize="21"
                        Margin="12,-119,0,119"
                        Click="ProjectSettings_Click" RenderTransformOrigin="0.724,0.516"/>

            </Grid>

        </StackPanel>


        <!-- =========================================================
             TIMER CARD
             ========================================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E1DDD5"
                BorderThickness="1"
                CornerRadius="20"
                Padding="24"
                Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- TODAY -->

                <TextBlock Grid.Row="0"
                           Text="Сегодня"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"/>


                <!-- TIMER + STATUS -->

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding TodayWorkedTimeText}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="58"
                               FontWeight="Bold"/>

                    <Border Background="#E2F8EB"
                            CornerRadius="18"
                            Padding="18,8"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="#10A94F"
                                     VerticalAlignment="Center"
                                     Margin="0,0,9,0"/>

                            <TextBlock Text="{Binding TimerState}"
                                       Foreground="#079447"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- ACTIONS -->

                <UniformGrid Grid.Row="2"
                             Columns="4"
                             Margin="-5,18,-5,0">

                    <Button Style="{StaticResource StartButton}"
                            IsEnabled="{Binding IsStopped}"
                            Click="Start_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▶"
                                       FontSize="18"
                                       Margin="0,0,9,0"/>

                            <TextBlock Text="Start"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Style="{StaticResource PauseButton}"
                            IsEnabled="{Binding IsRunning}"
                            Click="Pause_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Ⅱ"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,0,9,0"/>

                            <TextBlock Text="Pause"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Style="{StaticResource ResumeButton}"
                            IsEnabled="{Binding IsPaused}"
                            Click="Resume_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▶"
                                       FontSize="18"
                                       Margin="0,0,9,0"/>

                            <TextBlock Text="Resume"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Style="{StaticResource FinishButton}"
                            IsEnabled="{Binding IsRunning}"
                            Click="Finish_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="■"
                                       FontSize="16"
                                       Margin="0,0,9,0"/>

                            <TextBlock Text="Finish"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </UniformGrid>

            </Grid>

        </Border>


        <!-- =========================================================
             HISTORY
             ========================================================= -->

        <Button Grid.Row="3"
                Style="{StaticResource HistoryButton}"
                Click="History_Click">

            <Grid Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        Background="#FFF0D7"
                        CornerRadius="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                    <TextBlock Text="◷"
                               Foreground="#B97805"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="История"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="Просмотр отработанного времени и суммы"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="›"
                           Foreground="#B97805"
                           FontSize="34"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Button>

    </Grid>

</Window>