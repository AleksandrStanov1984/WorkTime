<Window x:Class="WorkTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime"
        Width="560"
        Height="506"
        MinWidth="520"
        MinHeight="430"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Закруглённые основные кнопки -->
        <Style x:Key="RoundedButton"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#B8B8B8"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#E5E5E5"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#D8D8D8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- Круглая кнопка добавления проекта -->
        <Style x:Key="AddButton"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButton}">

            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#E5E5E5"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#D8D8D8"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="WorkTime"
                   FontSize="28"
                   FontWeight="SemiBold"/>

        <!-- Выбор проекта -->
        <Grid Grid.Row="1"
              Margin="0,28,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Проект"
                       Margin="0,0,0,8"
                       FontSize="14"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Закруглённая оболочка ComboBox -->
                <Border Grid.Column="0"
                        Height="38"
                        CornerRadius="12"
                        BorderBrush="#B8B8B8"
                        BorderThickness="1"
                        Background="White"
                        ClipToBounds="True">

                    <ComboBox ItemsSource="{Binding Projects}"
          SelectedItem="{Binding SelectedProject}"
          DisplayMemberPath="Name"
          BorderThickness="0"
          Background="Transparent"
          Padding="10,0"
          VerticalContentAlignment="Center"
          SelectionChanged="Project_SelectionChanged"/>

                </Border>

                <!-- Добавление проекта -->
                <Button Grid.Column="1"
                        Content="+"
                        ToolTip="Добавить проект"
                        Style="{StaticResource AddButton}"
                        Click="NewProject_Click"/>

            </Grid>

        </Grid>

        <!-- Сегодняшнее время -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20">

            <TextBlock Text="Сегодня"
                       HorizontalAlignment="Center"
                       FontSize="16"/>

            <TextBlock Text="{Binding TodayWorkedTimeText}"
                       HorizontalAlignment="Center"
                       FontSize="54"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>

            <TextBlock Text="{Binding TimerState}"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <!-- Управление таймером -->
        <UniformGrid Grid.Row="3"
                     Columns="5"
                     Margin="0,10,0,0">

            <Button Content="Start"
        Style="{StaticResource RoundedButton}"
        IsEnabled="{Binding IsStopped}"
        Click="Start_Click"/>

            <Button Content="Pause"
        Style="{StaticResource RoundedButton}"
        IsEnabled="{Binding IsRunning}"
        Click="Pause_Click"/>

            <Button Content="Resume"
        Style="{StaticResource RoundedButton}"
        IsEnabled="{Binding IsPaused}"
        Click="Resume_Click"/>

            <Button Content="Finish"
        Style="{StaticResource RoundedButton}"
        IsEnabled="{Binding IsRunning}"
        Click="Finish_Click"/>

            <Button Content="History"
        Style="{StaticResource RoundedButton}"
        Click="History_Click"/>

        </UniformGrid>

    </Grid>

</Window>