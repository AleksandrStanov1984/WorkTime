<Window x:Class="WorkTime.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История"
        Width="760"
        Height="832"
        MinWidth="700"
        MinHeight="650"
        Background="#F8F7F4"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- =========================================================
             COMMON
             ========================================================= -->

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#C58A22"/>

        <SolidColorBrush x:Key="GoldDarkBrush"
                         Color="#9A6510"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#7B8495"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E1DDD5"/>


        <!-- =========================================================
             PERIOD BUTTON
             ========================================================= -->

        <Style x:Key="PeriodButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#DEDAD2"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFF6E6"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D6A44C"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1D39B"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             COMBOBOX
             ========================================================= -->

        <Style x:Key="HistoryComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF4DF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3D79E"/>
                                <Setter Property="Foreground" Value="#744600"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DDD8CF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ClosedBorder"
                                                Background="#FFFFFF"
                                                BorderBrush="#DED8CE"
                                                BorderThickness="1"
                                                CornerRadius="11">
                                            <Grid Margin="14,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#172033"
                                                           FontSize="15"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="⌄"
                                                           FontSize="18"
                                                           Foreground="#9A6510"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,7,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2D8C8"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="4"
                                                          Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- =========================================================
             BEAUTIFUL DATE PICKER + CALENDAR
             ========================================================= -->

        <Style x:Key="BeautifulCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#B9BEC7"/>
                                <Setter TargetName="DayBorder" Property="Background" Value="#FBFBFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#FFF1D7"/>
                                <Setter Property="Foreground" Value="#9A6510"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#C58A22"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Opacity" Value="0.30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BeautifulCalendarButton" TargetType="{x:Type CalendarButton}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarButton}">
                        <Border x:Name="MonthBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MonthBorder" Property="Background" Value="#FFF1D7"/>
                                <Setter Property="Foreground" Value="#9A6510"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BeautifulCalendar" TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3DDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource BeautifulCalendarDayButton}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource BeautifulCalendarButton}"/>
        </Style>

        <Style x:Key="HistoryDatePicker" TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DDE5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CalendarStyle" Value="{StaticResource BeautifulCalendar}"/>
        </Style>


        <!-- =========================================================
             SUMMARY VALUE
             ========================================================= -->

        <Style x:Key="SummaryValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Right"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         PAGE
         ============================================================= -->

    <Grid Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,26">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#FFF0D7"
                    CornerRadius="17">

                <TextBlock Text="◷"
                           Foreground="#A96E0A"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="История"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Просмотр отработанного времени и суммы"
                           FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0"/>

            </StackPanel>

        </Grid>


        <!-- =========================================================
             PROJECT
             ========================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">

            <TextBlock Text="Объект / Проект"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Margin="2,0,0,8"/>

            <Border Background="#FFFFFF"
                    BorderBrush="#DED8CE"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="2">

                <ComboBox x:Name="ProjectComboBox"
                          Style="{StaticResource HistoryComboBox}"
                          BorderThickness="0"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          DisplayMemberPath="Name"
                          SelectionChanged="Project_SelectionChanged"/>

            </Border>

        </StackPanel>


        <!-- =========================================================
             PERIOD
             ========================================================= -->

        <UniformGrid Grid.Row="2"
                     Columns="3"
                     Margin="-5,0,-5,20">

            <Button Style="{StaticResource PeriodButton}"
                    Click="Day_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="▣"
                               FontSize="19"
                               Foreground="#B77A13"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="День"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <Button Style="{StaticResource PeriodButton}"
                    Click="Week_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="▦"
                               FontSize="19"
                               Foreground="#667085"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="Неделя"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <Button Style="{StaticResource PeriodButton}"
                    Click="Month_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="▥"
                               FontSize="19"
                               Foreground="#667085"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="Месяц"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </UniformGrid>


        <!-- =========================================================
             DATE
             ========================================================= -->

        <Grid Grid.Row="3"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="▣"
                           Foreground="#BE7C0B"
                           FontSize="21"
                           Margin="0,0,10,0"/>

                <TextBlock Text="Дата"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D9DDE5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="3">

                <DatePicker x:Name="HistoryDatePicker"
                            Style="{StaticResource HistoryDatePicker}"
                            BorderThickness="0"
                            SelectedDate="{Binding SelectedDate}"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>

            </Border>

        </Grid>


        <!-- =========================================================
             PERIOD TITLE
             ========================================================= -->

        <TextBlock Grid.Row="4"
                   Text="{Binding PeriodText}"
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center"
                   FontSize="21"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>


        <!-- =========================================================
             SUMMARY CARD
             ========================================================= -->

        <Border Grid.Row="5"
                Background="White"
                BorderBrush="#E1DDD5"
                BorderThickness="1"
                CornerRadius="20"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- WORKED -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="#E2F8EB"
                            CornerRadius="13"
                            HorizontalAlignment="Left">

                        <TextBlock Text="◷"
                                   FontSize="24"
                                   Foreground="#079447"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Отработано"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Активное время"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#E4F9EC"
                            CornerRadius="13"
                            Padding="16,10">

                        <TextBlock Text="{Binding WorkedTimeText}"
                                   Style="{StaticResource SummaryValue}"
                                   Foreground="#078C43"/>

                    </Border>

                </Grid>


                <!-- PAUSE -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="#F8F0E3"
                            CornerRadius="13"
                            HorizontalAlignment="Left">

                        <TextBlock Text="Ⅱ"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#A56D17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Пауза"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Время на паузе"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#FBF2E4"
                            CornerRadius="13"
                            Padding="16,10">

                        <TextBlock Text="{Binding PauseTimeText}"
                                   Style="{StaticResource SummaryValue}"
                                   Foreground="#966118"/>

                    </Border>

                </Grid>


                <!-- RATE -->

                <Grid Grid.Row="2"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="#E6F1FF"
                            CornerRadius="13"
                            HorizontalAlignment="Left">

                        <TextBlock Text="€"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1769D2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Ставка"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Почасовая ставка"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#E6F1FF"
                            CornerRadius="13"
                            Padding="16,10">

                        <TextBlock Text="{Binding HourlyRateText}"
                                   Style="{StaticResource SummaryValue}"
                                   Foreground="#1769D2"/>

                    </Border>

                </Grid>


                <!-- SEPARATOR -->

                <Border Grid.Row="3"
                        Background="#EEEAE3"/>


                <!-- TOTAL -->

                <Grid Grid.Row="4"
                      Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="#FFF0C9"
                            CornerRadius="13"
                            HorizontalAlignment="Left">

                        <TextBlock Text="€"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#B97805"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Сумма"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Заработано за период"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#FFF1C9"
                            BorderBrush="#E6AE37"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,12">

                        <TextBlock Text="{Binding AmountText}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#704000"
                                   HorizontalAlignment="Right"/>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>