<Window x:Class="WorkTime.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый проект"
        Width="620"
        Height="480"
        MinWidth="620"
        MinHeight="480"
        MaxWidth="620"
        MaxHeight="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8F7F4"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- =========================================================
             COLORS
             ========================================================= -->

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0D1B36"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#78859D"/>

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#C58A22"/>


        <!-- =========================================================
             TEXT BOX
             ========================================================= -->

        <Style x:Key="ProjectTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDD7CC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#C58A22"/>

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#D1AA64"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             CANCEL BUTTON
             ========================================================= -->

        <Style x:Key="CancelButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="140"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D8D4CD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F3F2EF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E9E6E0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- =========================================================
             CREATE BUTTON
             ========================================================= -->

        <Style x:Key="CreateButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="150"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#C58A22"/>

            <Setter Property="BorderBrush"
                    Value="#A96E0A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D49A31"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#AA7110"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         PAGE
         ============================================================= -->

    <Grid Margin="38,32,38,30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,28">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#FFF0D7"
                    CornerRadius="17">

                <TextBlock Text="▣"
                           Foreground="#B97805"
                           FontSize="27"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="Новый проект"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Создайте новый проект для учёта рабочего времени"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0"/>

            </StackPanel>

        </Grid>


        <!-- =========================================================
             PROJECT NAME
             ========================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,22">

            <TextBlock Text="Название проекта"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="2,0,0,8"/>

            <Grid>

                <TextBox x:Name="NameTextBox"
                         Style="{StaticResource ProjectTextBox}"
                         Padding="58,0,16,0"/>

                <Border Width="44"
                        Height="44"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FFF4E2"
                        CornerRadius="10"
                        IsHitTestVisible="False">

                    <TextBlock Text="▣"
                               Foreground="#B97805"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </StackPanel>


        <!-- =========================================================
             HOURLY RATE
             ========================================================= -->

        <StackPanel Grid.Row="2">

            <TextBlock Text="Ставка в час (€)"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="2,0,0,8"/>

            <Grid>

                <TextBox x:Name="HourlyRateTextBox"
                         Style="{StaticResource ProjectTextBox}"
                         Padding="58,0,16,0"
                         Text="0"/>

                <Border Width="44"
                        Height="44"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FFF4E2"
                        CornerRadius="10"
                        IsHitTestVisible="False">

                    <TextBlock Text="€"
                               Foreground="#B97805"
                               FontSize="23"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </StackPanel>


        <!-- =========================================================
             BUTTONS
             ========================================================= -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Отмена"
                    Style="{StaticResource CancelButton}"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"/>

            <Button Content="Создать"
                    Style="{StaticResource CreateButton}"
                    Click="Create_Click"/>

        </StackPanel>

    </Grid>

</Window>